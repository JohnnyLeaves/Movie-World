{
  "name": "movie-world",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Your personal cinematic universe. Movies, series and anime in a cyberpunk library.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --android --iconBackgroundColor #12080b --splashBackgroundColor #0a0608",
    "apk": "cap sync android && cd android && gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "happy-dom": "21.0.3"
  }
}
